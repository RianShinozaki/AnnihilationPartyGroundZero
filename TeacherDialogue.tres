"1_1": {
"dialogue": "*You see an adult surrounded by young children. The oldest of them can't be much more than 9 years old.",
"offset": Vector2(-1800, -960),
"options": {
0: {
"condition": {},
"link": &"1_2",
"text": ""
}
},
"size": Vector2(300, 315.5),
"speaker": ""
},
"1_10": {
"dialogue": "Something about the name tickles your brain, and not at all pleasantly… but you have no idea beyond that.",
"offset": Vector2(1960, -940),
"options": {
