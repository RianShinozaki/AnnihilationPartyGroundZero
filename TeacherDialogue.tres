}
},
"size": Vector2(300, 315.5),
"speaker": ""
},
"1_2": {
"dialogue": "*Their faces are dirty, their clothes old, and their knees scraped. Despite this, shining smiles beam toward the adult in the center.",
"offset": Vector2(-1480, -960),
"options": {
0: {
"condition": {},
"link": &"1_3",
"text": ""
}
},
"size": Vector2(300, 315.5),
"speaker": ""
},
"1_3": {
"dialogue": "*The teacher smiles down on them in turn.",
"offset": Vector2(-1160, -960),
"options": {
0: {
"condition": {},
"link": &"1_4",
"text": ""
}
},
"size": Vector2(300, 315.5),
"speaker": ""
},
"1_4": {
"dialogue": "*As you approach, the Teacher suddenly turns to you. ",
"offset": Vector2(-840, -960),
"options": {
0: {
"condition": {},
"link": &"6_1",
"text": ""
}
},
"size": Vector2(323.958, 315.5),
"speaker": ""
},
"1_5": {
"dialogue": " [color=orchid]*Tension suddenly runs through them. They shake it off just as quickly.[/color]",
"offset": Vector2(-200, -1340),
"options": {
0: {
"condition": {},
"link": &"4_1",
"text": ""
}
},
"size": Vector2(300, 315.5),
"speaker": ""
},
"1_6": {
"dialogue": "*Still smiling brightly, the Teacher steps between you and the children and prepares their usual greeting.
",
"offset": Vector2(280, -960),
"options": {
0: {
"condition": {},
"link": &"1_7",
"text": ""
}
},
"size": Vector2(300, 315.5),
"speaker": ""
},
"1_7": {
"dialogue": "Ah, what have we here? Welcome to the Unobhel House Refugee Center!
",
"offset": Vector2(600, -960),
"options": {
0: {
"condition": {},
"link": &"1_8",
"text": ""
}
},
"size": Vector2(300, 315.5),
"speaker": ""
},
"1_8": {
"dialogue": "",
"offset": Vector2(980, -960),
"options": {
0: {
"condition": {
"operator": 0,
"value1": "{{f2}}",
"value2": "0"
},
"link": &"4_2",
"text": "{Unobhel House... what is that?)"
},
1: {
"condition": {
"operator": 0,
"value1": "{{f3}}",
"value2": "0"
},
"link": "END",
"text": "Lots of kids here."
},
2: {
"condition": {
"operator": 0,
"value1": "{{f1}}",
"value2": "1"
},
"link": "END",
"text": "Didn't mean to scare you..."
},
3: {
"condition": {
"operator": 0,
"value1": "{{f4}}",
"value2": "1"
},
"link": "END",
"text": "I'd like to join the volunteer effort."
}
},
"size": Vector2(300, 439.5),
"speaker": ""
},
